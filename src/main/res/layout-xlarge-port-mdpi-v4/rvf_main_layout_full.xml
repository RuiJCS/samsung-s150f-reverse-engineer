            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:01"/>
        <TextView
            android:textSize="40px"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" / "/>
        <TextView
            android:textSize="40px"
            android:textColor="#ffffff"
            android:id="@+id/rvf_remain_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20:00"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/rvf_gallery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15px"
        android:layout_marginTop="19px">
        <ImageView
            android:id="@+id/rvf_no_item"
            android:background="@drawable/rvf_camera_gallery_no_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/rvf_thumbnail"
            android:layout_width="80px"
            android:layout_height="80px"
            android:scaleType="centerCrop"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/rvf_option"
        android:background="@drawable/rvf_pooupwindow"
        android:visibility="gone"
        android:layout_width="573px"
        android:layout_height="wrap_content"
        android:layout_marginRight="170px"
        android:layout_alignParentRight="true">
        <TextView
            android:textSize="38px"
            android:id="@+id/rvf_menuTitle"
            android:layout_width="wrap_content"
            android:layout_height="76px"
            android:layout_marginLeft="12px"
            android:text="Flash"/>
        <ListView
            android:id="@+id/rvf_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:cacheColorHint="#00000000"
            android:dividerHeight="1dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/rvf_setting_sub_menu"
        android:background="@drawable/rvf_pooupwindow"
        android:visibility="gone"
        android:layout_width="573px"
        android:layout_height="wrap_content"
        android:layout_marginRight="114px"
        android:layout_alignParentRight="true">
        <TextView
            android:textSize="38px"
            android:id="@+id/rvf_setting_sub_menu_title"
            android:layout_width="wrap_content"
            android:layout_height="76px"
            android:layout_marginLeft="12px"
            android:text="Flash"/>
        <ListView
            android:id="@+id/rvf_setting_sub_menu_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:cacheColorHint="#00000000"
            android:dividerHeight="1dp"/>
    </LinearLayout>
    <include
        android:visibility="gone"
        android:layout_width="699px"
        android:layout_height="593px"
        android:layout_centerInParent="true"
        layout="@layout/rvf_smart_panel"/>
</RelativeLayout>
