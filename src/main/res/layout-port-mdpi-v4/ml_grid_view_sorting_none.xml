<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/ml_title_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_gravity="center_vertical"
            android:paddingLeft="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mobile_link"
            android:layout_weight="1"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/action_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12px"
            android:layout_marginRight="16px">
            <ImageButton
                android:id="@+id/ml_goto_rvf"
                android:background="@drawable/tw_action_bar_icon_camera_holo_dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:layout_gravity="center_vertical"
                android:id="@+id/textView1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="layout-port-mdpi"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/ml_grid_frame"
        android:paddingTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <GridView
            android:gravity="center"
            android:id="@+id/ml_gridview"
            android:paddingLeft="7.33dp"
            android:paddingRight="7.33dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:listSelector="@null"
            android:cacheColorHint="@null"
            android:horizontalSpacing="10dp"
            android:verticalSpacing="10dp"
            android:stretchMode="columnWidth"
            android:numColumns="4"/>
        <TextView
            android:textSize="22sp"
            android:gravity="center_vertical"
            android:id="@+id/ml_texttitle"
            android:background="@drawable/ml_subtitle_bg"
            android:paddingLeft="10dp"
            android:layout_width="match_parent"
            android:layout_height="48dp"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="0.07">
        <Button
            android:textSize="20sp"
            android:textColor="#ffffffff"
            android:id="@+id/ml_select_all_btn"
            android:background="#00000000"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/ml_select_all"
            android:layout_weight="1"/>
        <Button
            android:textSize="20sp"
            android:textColor="#ffffffff"
            android:id="@+id/ml_copy_btn"
            android:background="#00000000"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/ml_copy"
            android:layout_weight="1"/>
        <Button
            android:textSize="20sp"
            android:textColor="#ffffffff"
            android:id="@+id/ml_gallery_btn"
            android:background="#00000000"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/gallery"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
