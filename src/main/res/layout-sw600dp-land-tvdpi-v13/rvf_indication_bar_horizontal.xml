<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/rvf_indicator_bar"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageButton
        android:id="@+id/rvf_indicator_wb"
        android:background="@drawable/rvf_indicator_wb_daylight"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"/>
    <ImageButton
        android:id="@+id/rvf_indicator_metering"
        android:background="@drawable/rvf_indicator_metering_spot"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="1dp"/>
    <ImageButton
        android:id="@+id/rvf_indicator_drive"
        android:background="@drawable/rvf_indicator_drive_continuous"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="1dp"/>
    <ImageButton
        android:id="@+id/rvf_indicator_flash"
        android:background="@drawable/rvf_indicator_flash_fillin"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="1dp"/>
    <ImageButton
        android:id="@+id/rvf_indicator_photo_size"
        android:background="@drawable/rvf_indicator_size_20m"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="1dp"/>
    <ImageButton
        android:id="@+id/rvf_indicator_quality"
        android:background="@drawable/rvf_indicator_quality_raw"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="1dp"/>
    <ImageButton
        android:id="@+id/rvf_indicator_movie_size"
        android:background="@drawable/rvf_indicator_movie_size_1080_60p"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="1dp"/>
    <ImageButton
        android:id="@+id/rvf_indicator_af_area"
        android:background="@drawable/rvf_indicator_afarea_selection"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="1dp"/>
    <ImageButton
        android:id="@+id/rvf_indicator_touch_af"
        android:background="@drawable/rvf_indicator_touchaf_touchaf"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="1dp"/>
    <ImageButton
        android:id="@+id/rvf_indicator_storage"
        android:background="@drawable/rvf_indicator_storage_phone_camera"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="1dp"/>
</LinearLayout>
