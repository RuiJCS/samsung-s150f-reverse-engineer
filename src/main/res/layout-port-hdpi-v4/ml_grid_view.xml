<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:background="@drawable/ml_title_bg"
        android:paddingLeft="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ml_app_name"/>
    <FrameLayout
        android:id="@+id/ml_grid_frame"
        android:paddingTop="6.66dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <GridView
            android:gravity="center"
            android:id="@+id/ml_gridview"
            android:paddingLeft="7.33dp"
            android:paddingRight="7.33dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:listSelector="@null"
            android:cacheColorHint="@null"
            android:horizontalSpacing="6.66dp"
            android:verticalSpacing="6.66dp"
            android:stretchMode="columnWidth"
            android:numColumns="4"/>
        <TextView
            android:id="@+id/ml_texttitle"
            android:background="@drawable/ml_subtitle_bg"
            android:paddingLeft="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ml_copybtn1"
        android:background="@drawable/ml_custom_button_copy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/ml_copy_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5.33dp"
            android:src="@drawable/ml_copy_icon"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffffff"
            android:id="@+id/ml_copy_button_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ml_copy"/>
    </LinearLayout>
</LinearLayout>
