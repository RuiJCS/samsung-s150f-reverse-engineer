<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="276dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="18dp"
        android:gravity="center_vertical"
        android:id="@+id/title"
        android:background="#4a6a83"
        android:paddingLeft="11dp"
        android:paddingRight="11dp"
        android:layout_width="match_parent"
        android:layout_height="43dp"
        android:text="@string/ml_alert_guide_detail_title"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/contents_area"
        android:background="#1d2e3c"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="14dp"
            android:id="@+id/content_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="8dp"
            android:text="@string/ml_alert_guide_detail_content"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/content_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ml_detail_popup_image"/>
        <CheckBox
            android:id="@+id/content_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:text="@string/not_show_again"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="8dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/button_area"
        android:background="#bdbdbd"
        android:paddingTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="52dp">
        <Button
            android:textColor="#000000"
            android:id="@+id/button_ok"
            android:background="@drawable/selector_dialog_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@android:string/ok"/>
    </LinearLayout>
</LinearLayout>
