<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ml_layout_root"
    android:background="#1d2e3c"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="left"
        android:id="@+id/titleLayout"
        android:background="#4a6a83"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="40dp">
        <TextView
            android:textSize="21sp"
            android:gravity="left"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="5dp"
            android:text="Title"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:background="#113544"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="7dp"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="15dp">
        <TextView
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:layout_gravity="center_vertical"
            android:id="@+id/ml_infotext2"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="left"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="10dp">
        <CheckBox
            android:id="@+id/ml_noticecheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="16sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:text="@string/not_show_again"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/button_area"
        android:background="#bdbdbd"
        android:padding="2dp"
        android:layout_width="match_parent"
        android:layout_height="41dp"
        android:minWidth="420dp">
        <Button
            android:textColor="#000000"
            android:id="@+id/btnOk"
            android:background="@drawable/selector_dialog_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@android:string/ok"/>
    </LinearLayout>
</LinearLayout>
