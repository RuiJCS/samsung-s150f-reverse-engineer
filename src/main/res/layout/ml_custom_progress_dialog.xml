<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#1d2e3c"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="left"
        android:id="@+id/titleLayout2"
        android:background="#4a6a83"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="40dp">
        <ImageView
            android:id="@+id/showPicture2"
            android:background="@drawable/ml_tw_popup_title_info_icon"
            android:paddingLeft="5dp"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="5dp"/>
        <TextView
            android:textSize="21sp"
            android:gravity="left"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="Title"/>
    </LinearLayout>
    <RelativeLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/titleLayout2">
        <ImageView
            android:id="@+id/showPicture"
            android:layout_width="150dp"
            android:layout_height="110dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:layout_centerHorizontal="true"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/ml_PartInfo"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_below="@+id/showPicture">
            <TextView
                android:id="@+id/ml_partInfo_fileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TextView"
                android:singleLine="true"/>
            <LinearLayout
                android:gravity="right"
                android:layout_gravity="right"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/ml_partInfo_downloadedSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TextView"
                    android:singleLine="true"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" / "
                    android:singleLine="true"/>
                <TextView
                    android:id="@+id/ml_partInfo_fileSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TextView"
                    android:singleLine="true"/>
            </LinearLayout>
        </LinearLayout>
        <ProgressBar
            android:id="@+id/ml_partInfo_progressBar"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_below="@+id/ml_PartInfo"
            style="?android:attr/progressBarStyleHorizontal"/>
        <LinearLayout
            android:id="@+id/ml_totalInfo"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="16dp"
            android:layout_below="@+id/ml_partInfo_progressBar">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total ["
                android:singleLine="true"/>
            <TextView
                android:id="@+id/ml_totalInfo_currentIndex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="currentIndex"
                android:singleLine="true"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="/"
                android:singleLine="true"/>
            <TextView
                android:id="@+id/ml_totalInfo_totalCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="totalCount"
                android:singleLine="true"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="]"
                android:singleLine="true"/>
            <LinearLayout
                android:gravity="right"
                android:layout_gravity="right"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="right"
                    android:id="@+id/ml_totalInfo_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/ml_totalInfo_currentDownloadedSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TextView"
                        android:singleLine="true"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" / "
                        android:singleLine="true"/>
                    <TextView
                        android:id="@+id/ml_totalInfo_totalSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TextView"
                        android:singleLine="true"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <ProgressBar
            android:id="@+id/ml_totalInfo_progressBar"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_below="@+id/ml_totalInfo"
            style="?android:attr/progressBarStyleHorizontal"/>
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/button_area"
            android:background="#bdbdbd"
            android:padding="2dp"
            android:layout_width="match_parent"
            android:layout_height="41dp"
            android:layout_marginTop="12dp"
            android:layout_below="@+id/ml_totalInfo_progressBar">
            <Button
                android:textStyle="bold"
                android:textColor="#000000"
                android:id="@+id/btnOk"
                android:background="@drawable/selector_dialog_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cancel"/>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
