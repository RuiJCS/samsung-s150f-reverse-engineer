                        android:inputType="textVisiblePassword"/>
                </LinearLayout>
                <TextView
                    android:textSize="16dp"
                    android:textColor="#00b7ff"
                    android:id="@+id/tv_cm_testmode_ssid_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp"
                    android:layout_marginRight="14dp"
                    android:text="AP_SSC_"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <LinearLayout
        android:background="#454a4e"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="50dp"
        android:layout_alignParentBottom="true"/>
    <LinearLayout
        android:background="#ff000000"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <Button
            android:textColor="#d7d7d7"
            android:id="@+id/btn_cm_testmode_confirm"
            android:background="@drawable/selector_default_button"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="4dp"
            android:text="@string/cm_confirm"/>
    </LinearLayout>
</RelativeLayout>
