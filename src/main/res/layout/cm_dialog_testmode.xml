                        android:hint="Ex) F2"
                        android:inputType="textVisiblePassword"/>
                    <TextView
                        android:textSize="16dp"
                        android:textColor="#00b7ff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"/>
                    <EditText
                        android:textSize="16dp"
                        android:id="@+id/et_cm_testmode_mac03_2"
                        android:nextFocusDown="@+id/et_cm_testmode_modelname_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:hint="Ex) F2"
                        android:inputType="textVisiblePassword"/>
                </LinearLayout>
                <TextView
                    android:textSize="16dp"
