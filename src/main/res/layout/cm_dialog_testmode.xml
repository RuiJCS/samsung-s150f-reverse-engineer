                        android:id="@+id/et_cm_testmode_mac03"
                        android:nextFocusDown="@+id/et_cm_testmode_modelname_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:hint="Ex) F2"
                        android:inputType="textVisiblePassword"/>
                </LinearLayout>
                <TextView
                    android:textSize="16dp"
                    android:textColor="#00b7ff"
                    android:id="@+id/tv_cm_testmode_ssid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp"
                    android:layout_marginRight="14dp"
                    android:text="AP_SSC_"/>
                <Spinner
                    android:id="@+id/spinner_cm_testmode_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
