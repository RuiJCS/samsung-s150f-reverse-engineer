<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#ff000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:background="#3f5364"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <ImageView
            android:background="@drawable/sca_popup_icon_app_sca"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginLeft="17dp"
            android:layout_marginTop="13dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="13dp"/>
        <TextView
            android:textSize="20dp"
            android:textColor="#d7d7d7"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/app_name"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp">
        <ScrollView
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="52dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Spinner
                    android:id="@+id/spinner_cm_testmode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16dp"
                        android:textColor="#00b7ff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="14dp"
                        android:layout_marginRight="14dp"
                        android:text="Model :"/>
                    <EditText
                        android:textSize="16dp"
                        android:id="@+id/et_cm_testmode_modelname"
                        android:nextFocusDown="@+id/et_cm_testmode_mac01"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ex) WB250, NX300, GC100"
                        android:inputType="textVisiblePassword"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16dp"
                        android:textColor="#00b7ff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="14dp"
                        android:layout_marginRight="14dp"
                        android:text="Mac :"/>
                    <EditText
                        android:textSize="16dp"
                        android:id="@+id/et_cm_testmode_mac01"
                        android:nextFocusDown="@+id/et_cm_testmode_mac02"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:hint="Ex) F2"
                        android:inputType="textVisiblePassword"/>
                    <TextView
                        android:textSize="16dp"
                        android:textColor="#00b7ff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"/>
                    <EditText
                        android:textSize="16dp"
                        android:id="@+id/et_cm_testmode_mac02"
                        android:nextFocusDown="@+id/et_cm_testmode_mac03"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:hint="Ex) F2"
                        android:inputType="textVisiblePassword"/>
                    <TextView
                        android:textSize="16dp"
                        android:textColor="#00b7ff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"/>
                    <EditText
