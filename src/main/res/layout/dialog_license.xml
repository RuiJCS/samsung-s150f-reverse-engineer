<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/tw_ab_transparent_dark_holo"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:gravity="center_vertical"
        android:id="@+id/txtVwLicenseTitle"
        android:paddingLeft="10dp"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/license"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"/>
    <WebView
        android:id="@+id/webView1"
        android:background="@drawable/tw_ab_transparent_dark_holo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/btnClose"
        android:layout_below="@+id/txtVwLicenseTitle"/>
    <RelativeLayout
        android:orientation="vertical"
        android:background="#bdbdbd"
        android:padding="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minWidth="420dp"
        android:layout_alignParentBottom="true">
        <Button
            android:textStyle="bold"
            android:textColor="#000000"
            android:id="@+id/btnClose"
            android:background="@drawable/selector_dialog_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@android:string/ok"/>
    </RelativeLayout>
</RelativeLayout>
