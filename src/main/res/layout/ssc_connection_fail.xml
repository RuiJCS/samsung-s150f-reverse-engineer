<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ssc_connection_fail_dialog"
    android:layout_width="310dp"
    android:layout_height="270dp">
    <ScrollView
        android:id="@+id/scrollView"
        android:scrollbars="none"
        android:layout_width="wrap_content"
        android:layout_height="220dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textColor="#ffebebeb"
                android:id="@+id/ssc_connection_fail"
                android:paddingLeft="17dp"
                android:paddingTop="20dp"
                android:paddingRight="17dp"
                android:paddingBottom="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rejected_connection"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#ffebebeb"
                android:id="@+id/ssc_rejected_camera"
                android:paddingLeft="17dp"
                android:paddingRight="17dp"
                android:paddingBottom="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cm_camera_info"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="47dp">
        <Button
            android:textSize="17dp"
            android:id="@+id/ssc_confirm_btn"
            android:layout_width="match_parent"
            android:layout_height="47dp"
            android:layout_margin="1dp"
            android:text="@string/cm_confirm"/>
    </LinearLayout>
</LinearLayout>
