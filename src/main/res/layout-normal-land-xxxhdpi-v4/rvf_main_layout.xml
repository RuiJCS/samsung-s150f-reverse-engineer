            android:background="@drawable/rvf_custom_button_camera_zoom_plus"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:layout_marginTop="15dp"
            android:layout_centerHorizontal="true"/>
        <com.samsungimaging.connectionmanager.widget.VerticalSeekBar
            android:id="@+id/rvf_zoomSeekBar"
            android:paddingLeft="40px"
            android:paddingRight="40px"
            android:layout_width="wrap_content"
            android:layout_height="167dp"
            android:maxHeight="18px"
            android:progressDrawable="@drawable/rvf_custom_progress_v"
            android:thumb="@drawable/rvf_custom_thumb_drawable"
            android:thumbOffset="40px"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <Button
        android:id="@+id/rvf_mode_button"
        android:background="@drawable/rvf_custom_button_mode"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginRight="6dp"
        android:layout_marginBottom="50dp"
        android:text="Mode"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"/>
    <ImageButton
        android:id="@+id/rvf_shutter_button"
        android:background="@drawable/rvf_custom_button_camera_btn_camera_bg_v"
        android:layout_width="60dp"
        android:layout_height="100dp"
        android:layout_marginRight="6dp"
        android:src="@drawable/rvf_custom_button_camera_btn_camera_icon"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <ImageButton
        android:id="@+id/rvf_camcorder_button"
        android:background="@drawable/rvf_custom_button_camcorder"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="52dp"
        android:layout_marginRight="6dp"
        android:layout_alignParentRight="true"/>
    <ImageButton
        android:id="@+id/rvf_rec_stop_button"
        android:background="@drawable/rvf_custom_button_camera_btn_camera_bg_v"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="54px"
        android:src="@drawable/rvf_custom_button_camera_btn_stop_icon"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <LinearLayout
        android:id="@+id/rvf_rec_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="42px"
        android:layout_marginTop="42px">
        <ImageView
            android:id="@+id/rvf_rec_icon"
            android:background="@drawable/rvf_camera_icon_recording"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="54px"
            android:textColor="#ff2400"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REC"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/rvf_rec_time"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24px"
        android:layout_marginTop="42px"
        android:layout_toRightOf="@+id/rvf_rec_title">
        <TextView
            android:textSize="60px"
            android:textColor="#ffffff"
            android:id="@+id/rvf_recording_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:01"/>
        <TextView
            android:textSize="60px"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" / "/>
        <TextView
            android:textSize="60px"
            android:textColor="#ffffff"
            android:id="@+id/rvf_remain_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20:00"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/rvf_gallery"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:layout_alignParentBottom="true">
        <ImageView
            android:id="@+id/rvf_no_item"
            android:background="@drawable/rvf_camera_gallery_no_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/rvf_thumbnail"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:scaleType="centerCrop"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/rvf_option"
        android:background="@drawable/rvf_pooupwindow"
        android:visibility="gone"
        android:layout_width="259dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="70dp">
        <TextView
            android:textSize="19sp"
            android:id="@+id/rvf_menuTitle"
            android:layout_width="wrap_content"
            android:layout_height="39dp"
            android:layout_marginLeft="12px"
            android:text="Flash"/>
        <ListView
            android:id="@+id/rvf_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:cacheColorHint="#00000000"
            android:dividerHeight="1dp"/>
        <TextView
            android:background="#70ffffff"
            android:layout_width="match_parent"
            android:layout_height="0.008dp"
            android:layout_marginBottom="17dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/rvf_setting_sub_menu"
        android:background="@drawable/rvf_pooupwindow"
        android:visibility="gone"
        android:layout_width="861px"
        android:layout_height="wrap_content"
        android:layout_marginLeft="59px"
        android:layout_marginTop="250px">
        <TextView
            android:textSize="38px"
            android:id="@+id/rvf_setting_sub_menu_title"
            android:layout_width="wrap_content"
            android:layout_height="114px"
            android:layout_marginLeft="12px"
            android:text="Flash"/>
        <ListView
            android:id="@+id/rvf_setting_sub_menu_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:cacheColorHint="#00000000"
            android:dividerHeight="1dp"/>
    </LinearLayout>
    <include
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        layout="@layout/rvf_smart_panel"/>
</RelativeLayout>
