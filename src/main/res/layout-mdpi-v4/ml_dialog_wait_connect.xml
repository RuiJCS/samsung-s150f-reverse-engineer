<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#1d2e3c"
    android:layout_width="wrap_content"
    android:layout_height="295dp"
    android:minWidth="396dp">
    <TextView
        android:textSize="16dp"
        android:textColor="#ebebeb"
        android:gravity="center"
        android:id="@+id/tv_cm_wait_dialog_text"
        android:layout_width="match_parent"
        android:layout_height="114dp"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="15dp"/>
    <ProgressBar
        android:layout_gravity="center_horizontal"
        android:id="@+id/pbar_cm_wait_connect"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10.5dp"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="16dp"
        android:textColor="#ebebeb"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="19dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:text="@string/cm_waitconnect_myphone"/>
    <TextView
        android:textSize="16dp"
        android:textColor="#00b7ff"
        android:gravity="center"
        android:id="@+id/tv_cm_waitconnect_phone_mac"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="23dp"
        android:text="@string/cm_waitconnect_phone_mac"/>
    <LinearLayout
        android:background="#9c9a9c"
        android:layout_width="match_parent"
        android:layout_height="47dp">
        <Button
            android:gravity="center"
            android:id="@+id/btn_cm_waitconnect_close"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="4.5dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="4.5dp"
            android:layout_marginBottom="3dp"
            android:text="@android:string/cancel"/>
    </LinearLayout>
</LinearLayout>
