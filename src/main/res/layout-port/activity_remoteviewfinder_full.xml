            android:layout_height="114px"
            android:layout_marginLeft="12px"
            android:text="Flash"/>
        <ListView
            android:id="@+id/rvf_setting_sub_menu_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
