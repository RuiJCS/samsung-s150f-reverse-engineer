<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:background="@drawable/ml_title_bg"
        android:layout_width="match_parent"
        android:layout_height="96px">
        <TextView
            android:textSize="26px"
            android:layout_gravity="center_vertical"
            android:paddingLeft="32px"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mobile_link"
            android:layout_weight="1"/>
        <TextView
            android:textSize="22px"
            android:layout_gravity="center_vertical"
            android:id="@+id/ml_texttitle"
            android:paddingRight="32px"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/action_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8px"
            android:layout_marginRight="12px">
            <ImageButton
                android:layout_gravity="center_vertical"
                android:id="@+id/ml_goto_rvf"
                android:background="@drawable/tw_action_bar_icon_camera_holo_dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8px"/>
            <TextView
                android:textSize="22px"
                android:layout_gravity="center_vertical"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/remote_viewfinder"/>
        </LinearLayout>
    </LinearLayout>
    <ExpandableListView
        android:id="@+id/expandableListView"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:listSelector="@drawable/ml_play_expand_seletor"
        android:groupIndicator="@drawable/ml_play_expand_background"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="64px">
        <Button
            android:textSize="24px"
            android:textColor="#ebebeb"
            android:id="@+id/ml_select_all_btn"
            android:background="#00000000"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/ml_select_all"
            android:layout_weight="1"/>
        <Button
            android:textSize="24px"
            android:textColor="#ebebeb"
            android:id="@+id/ml_copy_btn"
            android:background="#00000000"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/ml_copy"
            android:layout_weight="1"/>
        <Button
            android:textSize="24px"
            android:textColor="#ebebeb"
            android:id="@+id/ml_gallery_btn"
            android:background="#00000000"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/gallery"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
