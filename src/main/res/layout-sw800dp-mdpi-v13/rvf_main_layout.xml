            android:background="@drawable/rvf_custom_button_quick_setting_open"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="79dp">
        <include
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/rvf_indication_bar_horizontal"/>
        <ProgressBar
            android:id="@+id/rvf_progress"
            android:visibility="gone"
            android:layout_width="25dp"
            android:layout_height="25dp"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/rvf_zoomMain"
        android:background="@drawable/rvf_tw_toast_frame_holo_dark"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="126dp"
        android:layout_marginLeft="130dp"
        android:layout_marginRight="130dp"
        android:layout_marginBottom="25dp"
        android:layout_above="@+id/rvf_shutter_button"
        android:layout_centerHorizontal="true">
        <ImageButton
            android:id="@+id/rvf_zoomout_button"
            android:background="@drawable/rvf_custom_button_camera_zoom_minus"
            android:layout_width="64dp"
            android:layout_height="56dp"
            android:layout_marginLeft="20dp"
            android:layout_centerVertical="true"/>
        <ImageButton
            android:id="@+id/rvf_zoomin_button"
            android:background="@drawable/rvf_custom_button_camera_zoom_plus"
            android:layout_width="64dp"
            android:layout_height="56dp"
            android:layout_marginRight="20dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <SeekBar
            android:id="@+id/rvf_zoomSeekBar"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:maxHeight="6dp"
            android:progressDrawable="@drawable/rvf_custom_progress_v"
            android:thumb="@drawable/rvf_custom_thumb_drawable"
            android:thumbOffset="40px"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <Button
        android:id="@+id/rvf_mode_button"
        android:background="@drawable/rvf_custom_button_mode"
        android:visibility="gone"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginLeft="140px"
        android:layout_marginBottom="18dp"
        android:text="Mode"
        android:layout_alignParentBottom="true"/>
    <ImageButton
        android:id="@+id/rvf_shutter_button"
        android:background="@drawable/rvf_custom_button_camera_btn_camera_bg_h"
        android:paddingLeft="31dp"
        android:paddingTop="12dp"
        android:paddingRight="32dp"
        android:paddingBottom="11dp"
        android:layout_width="170dp"
        android:layout_height="110dp"
        android:layout_marginBottom="18dp"
        android:src="@drawable/rvf_custom_button_camera_btn_camera_icon"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <ImageButton
        android:id="@+id/rvf_camcorder_button"
        android:background="@drawable/rvf_custom_button_camcorder"
        android:paddingLeft="31dp"
        android:paddingTop="12dp"
        android:paddingRight="32dp"
        android:paddingBottom="11dp"
        android:visibility="gone"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginRight="140px"
        android:layout_marginBottom="18dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"/>
    <ImageButton
        android:id="@+id/rvf_rec_stop_button"
        android:background="@drawable/rvf_custom_button_camera_btn_camera_bg_h"
        android:paddingLeft="31dp"
        android:paddingTop="12dp"
        android:paddingRight="32dp"
        android:paddingBottom="11dp"
        android:visibility="gone"
        android:layout_width="100dp"
        android:layout_height="60dp"
        android:src="@drawable/rvf_custom_button_camera_btn_stop_icon"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:id="@+id/rvf_rec_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginRight="17dp"
        android:layout_alignParentRight="true">
        <ImageView
            android:id="@+id/rvf_rec_icon"
            android:background="@drawable/rvf_camera_icon_recording"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="18sp"
            android:textColor="#ff2400"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REC"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/rvf_rec_time"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginRight="17dp"
        android:layout_below="@+id/rvf_rec_title"
        android:layout_alignParentRight="true">
        <TextView
            android:textSize="20sp"
            android:textColor="#ffffff"
            android:id="@+id/rvf_recording_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:01"/>
        <TextView
            android:textSize="20sp"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" / "/>
        <TextView
            android:textSize="20sp"
            android:textColor="#ffffff"
            android:id="@+id/rvf_remain_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20:00"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/rvf_gallery"
        android:layout_width="85dp"
        android:layout_height="85dp"
        android:layout_marginTop="47dp"
        android:layout_marginRight="21dp"
        android:layout_below="@+id/liveViewLayout"
        android:layout_alignParentRight="true">
        <ImageView
            android:id="@+id/rvf_no_item"
            android:background="@drawable/rvf_camera_gallery_no_item02"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/rvf_thumbnail"
            android:layout_width="85dp"
            android:layout_height="85dp"
            android:scaleType="centerCrop"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/rvf_option"
        android:background="@drawable/rvf_pooupwindow"
        android:visibility="gone"
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="65dp"
        android:layout_marginTop="817dp">
        <TextView
            android:textSize="22sp"
            android:id="@+id/rvf_menuTitle"
            android:paddingLeft="18dp"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:text="Flash"/>
        <ListView
            android:id="@+id/rvf_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:cacheColorHint="#00000000"
            android:dividerHeight="1dp"/>
        <TextView
            android:background="#70ffffff"
            android:layout_width="match_parent"
            android:layout_height="0.008dp"
            android:layout_marginBottom="17dp"/>
    </LinearLayout>
    <include
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        layout="@layout/rvf_smart_panel"/>
</RelativeLayout>
