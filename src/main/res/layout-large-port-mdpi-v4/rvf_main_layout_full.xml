            android:layout_height="wrap_content"
            android:text="00:01"/>
        <TextView
            android:textSize="32px"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" / "/>
        <TextView
            android:textSize="32px"
            android:textColor="#ffffff"
            android:id="@+id/rvf_remain_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20:00"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/rvf_gallery"
        android:layout_width="109px"
        android:layout_height="109px"
        android:layout_marginLeft="11px"
        android:layout_marginTop="3px">
        <ImageView
            android:id="@+id/rvf_no_item"
            android:background="@drawable/rvf_camera_gallery_no_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/rvf_thumbnail"
            android:layout_width="66px"
            android:layout_height="66px"
            android:scaleType="centerCrop"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/rvf_option"
        android:background="@drawable/rvf_pooupwindow"
        android:visibility="gone"
        android:layout_width="446px"
        android:layout_height="wrap_content"
        android:layout_marginRight="116px"
        android:layout_alignParentRight="true">
        <TextView
            android:textSize="30px"
            android:id="@+id/rvf_menuTitle"
            android:layout_width="wrap_content"
            android:layout_height="63px"
            android:layout_marginLeft="12px"
            android:layout_marginTop="12px"
            android:text="Flash"/>
        <ListView
            android:id="@+id/rvf_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:cacheColorHint="#00000000"
            android:dividerHeight="1dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/rvf_setting_sub_menu"
        android:background="@drawable/rvf_pooupwindow"
        android:visibility="gone"
        android:layout_width="446px"
        android:layout_height="wrap_content"
        android:layout_marginLeft="41dp"
        android:layout_marginTop="21dp">
        <TextView
            android:textSize="30px"
            android:id="@+id/rvf_setting_sub_menu_title"
            android:layout_width="wrap_content"
            android:layout_height="63px"
            android:layout_marginLeft="12px"
            android:text="Flash"/>
        <ListView
            android:id="@+id/rvf_setting_sub_menu_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:cacheColorHint="#00000000"
            android:dividerHeight="1dp"/>
    </LinearLayout>
    <include
        android:visibility="gone"
        android:layout_width="560px"
        android:layout_height="475px"
        android:layout_centerInParent="true"
        layout="@layout/rvf_smart_panel"/>
</RelativeLayout>
