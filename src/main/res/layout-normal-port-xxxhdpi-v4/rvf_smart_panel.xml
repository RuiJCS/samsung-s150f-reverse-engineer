<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/rvf_smart_panel"
    android:background="@drawable/rvf_camera_menu_popup_bg2"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <org.kankan.wheel.widget.WheelView
            android:id="@+id/rvf_smart_panel_mode"
            android:background="@drawable/rvf_mode_program_wheel_nor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="left"
        android:paddingRight="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="2">
        <org.kankan.wheel.widget.WheelView
            android:id="@+id/rvf_smart_panel_shutterSpeed"
            android:background="@drawable/rvf_camera_settings_wheel_nor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <org.kankan.wheel.widget.WheelView
            android:id="@+id/rvf_smart_panel_aperture"
            android:background="@drawable/rvf_camera_settings_wheel_nor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:paddingRight="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="2">
        <org.kankan.wheel.widget.WheelView
            android:id="@+id/rvf_smart_panel_ev"
            android:background="@drawable/rvf_camera_settings_wheel_nor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <org.kankan.wheel.widget.WheelView
            android:id="@+id/rvf_smart_panel_iso"
            android:background="@drawable/rvf_camera_settings_wheel_nor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:paddingRight="6dp"
        android:paddingBottom="5dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:weightSum="4"
            android:layout_weight="1">
            <ImageButton
                android:id="@+id/rvf_smart_panel_wb"
                android:background="@drawable/rvf_camera_settings_btn_normal"
                android:paddingLeft="20dp"
                android:paddingTop="6dp"
                android:paddingRight="20dp"
                android:paddingBottom="7dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/rvf_custom_button_camera_wb_acamera_wb"
                android:layout_weight="1"/>
            <ImageButton
                android:id="@+id/rvf_smart_panel_metering"
                android:background="@drawable/rvf_camera_settings_btn_normal"
                android:paddingLeft="20dp"
                android:paddingTop="6dp"
                android:paddingRight="20dp"
                android:paddingBottom="7dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/rvf_custom_button_camera_metering_multi"
                android:layout_weight="1"/>
            <ImageButton
                android:id="@+id/rvf_smart_panel_drive"
                android:background="@drawable/rvf_camera_settings_btn_normal"
                android:paddingLeft="20dp"
                android:paddingTop="6dp"
                android:paddingRight="20dp"
                android:paddingBottom="7dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/rvf_custom_button_camera_drive_15fps"
                android:layout_weight="1"/>
            <ImageButton
                android:id="@+id/rvf_smart_panel_flash"
                android:background="@drawable/rvf_camera_settings_btn_normal"
                android:paddingLeft="20dp"
                android:paddingTop="6dp"
                android:paddingRight="20dp"
                android:paddingBottom="7dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/rvf_custom_button_camera_flash_flash_auto"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:weightSum="4"
            android:layout_weight="1">
            <ImageButton
                android:id="@+id/rvf_smart_panel_afMode"
                android:background="@drawable/rvf_camera_settings_btn_normal"
                android:paddingLeft="20dp"
                android:paddingTop="6dp"
                android:paddingRight="20dp"
                android:paddingBottom="7dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/rvf_custom_button_camera_af_mode_caf"/>
            <ImageButton
                android:id="@+id/rvf_smart_panel_photoSize"
                android:background="@drawable/rvf_camera_settings_btn_normal"
                android:paddingLeft="20dp"
                android:paddingTop="6dp"
                android:paddingRight="20dp"
                android:paddingBottom="7dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/rvf_custom_button_camera_size_20m"
                android:layout_weight="1"/>
            <ImageButton
                android:id="@+id/rvf_smart_panel_quality"
                android:background="@drawable/rvf_camera_settings_btn_normal"
                android:paddingLeft="20dp"
                android:paddingTop="6dp"
                android:paddingRight="20dp"
                android:paddingBottom="7dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/rvf_custom_button_camera_quality_normal"
                android:layout_weight="1"/>
            <ImageButton
                android:id="@+id/rvf_smart_panel_movieSize"
                android:background="@drawable/rvf_camera_settings_btn_normal"
                android:paddingLeft="20dp"
                android:paddingTop="6dp"
                android:paddingRight="20dp"
                android:paddingBottom="7dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/rvf_custom_button_camera_flash_flash_auto"
                android:layout_weight="1"/>
            <ImageButton
                android:id="@+id/rvf_smart_panel_streaming_quality"
                android:background="@drawable/rvf_camera_settings_btn_normal"
                android:paddingLeft="20dp"
                android:paddingTop="6dp"
                android:paddingRight="20dp"
                android:paddingBottom="7dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/rvf_custom_button_camera_streaming_quality"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:paddingRight="2dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:weightSum="4"
            android:layout_weight="1">
            <ImageButton
                android:id="@+id/rvf_smart_panel_afArea"
                android:background="@drawable/rvf_camera_settings_btn_normal"
                android:paddingLeft="20dp"
                android:paddingTop="6dp"
                android:paddingRight="20dp"
                android:paddingBottom="7dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/rvf_custom_button_camera_afarea_multi"
                android:layout_weight="1"/>
            <ImageButton
                android:id="@+id/rvf_smart_panel_touchAF"
                android:background="@drawable/rvf_camera_settings_btn_normal"
                android:paddingLeft="20dp"
                android:paddingTop="6dp"
                android:paddingRight="20dp"
                android:paddingBottom="7dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/rvf_custom_button_camera_touchaf_off"
                android:layout_weight="1"/>
            <ImageButton
                android:id="@+id/rvf_smart_panel_save"
                android:background="@drawable/rvf_camera_settings_btn_normal"
                android:paddingLeft="20dp"
                android:paddingTop="6dp"
                android:paddingRight="20dp"
                android:paddingBottom="7dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/rvf_custom_button_camera_save_save"
                android:layout_weight="1"/>
            <ImageButton
                android:id="@+id/rvf_smart_panel_dummy3"
                android:background="@drawable/rvf_camera_settings_btn_normal"
                android:paddingLeft="20dp"
                android:paddingTop="6dp"
                android:paddingRight="20dp"
                android:paddingBottom="7dp"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/rvf_custom_button_camera_save_save"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
