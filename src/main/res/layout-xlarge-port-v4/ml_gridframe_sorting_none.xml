<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ml_frame1"
    android:layout_width="140dp"
    android:layout_height="140dp">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/ml_playback_button"
        android:background="#00000000"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:src="@drawable/ml_loading"
        android:scaleType="fitXY"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/ml_thumbnail"
        android:background="#ff000000"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:src="@drawable/ml_loading"
        android:layout_centerVertical="true"/>
    <ImageView
        android:layout_gravity="center"
        android:background="@drawable/ml_image_frame"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_centerVertical="true"/>
    <CheckBox
        android:gravity="top"
        android:id="@+id/ml_custom_checkbox"
        android:background="#00000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/ml_custom_movie"
        android:background="#00000000"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ml_movie"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/ml_not_support_mask"
        android:background="#ac000000"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
