<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Default" parent="@android:style/Theme.Holo">
        <item name="android:buttonStyle">@style/Widget.Button</item>
        <item name="android:checkboxStyle">@style/Widget.CompoundButton.CheckBox</item>
        <item name="android:dropDownListViewStyle">@style/Widget.ListView</item>
        <item name="android:imageButtonStyle">@style/Widget.ImageButton</item>
        <item name="android:listViewStyle">@style/Widget.ListView</item>
        <item name="android:popupWindowStyle">@style/Widget.PopupWindow</item>
        <item name="android:progressBarStyle">@style/Widget.ProgressBar</item>
        <item name="android:progressBarStyleHorizontal">@style/Widget.ProgressBar.Horizontal</item>
        <item name="android:radioButtonStyle">@style/Widget.CompoundButton.RadioButton</item>
        <item name="android:textColor">@color/selector_text</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:actionBarStyle">@style/ActionBarStyle</item>
        <item name="android:actionButtonStyle">@style/ActionButtonStyle</item>
        <item name="android:listPopupWindowStyle">@style/Widget.PopupWindow</item>
        <item name="android:popupMenuStyle">@style/Widget.PopupWindow</item>
        <item name="android:alertDialogTheme">@style/Theme.Default.Alert</item>
        <item name="android:homeAsUpIndicator">@drawable/tw_ic_ab_back_holo_dark</item>
    </style>
    <style name="Theme.ShowWallpaper" parent="@style/Theme.Default">
        <item name="android:windowShowWallpaper">true</item>
    </style>
    <style name="Theme.Default.Alert" parent="@android:style/Theme.Dialog">
        <item name="android:buttonStyle">@style/Widget.Button.Dialog</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:checkboxStyle">@style/Widget.CompoundButton.CheckBox</item>
        <item name="android:imageButtonStyle">@style/Widget.ImageButton</item>
        <item name="android:listViewStyle">@style/Widget.ListView</item>
        <item name="android:progressBarStyle">@style/Widget.ProgressBar</item>
        <item name="android:progressBarStyleHorizontal">@style/Widget.ProgressBar.Horizontal</item>
        <item name="android:radioButtonStyle">@style/Widget.CompoundButton.RadioButton</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowMinWidthMajor">0%</item>
        <item name="android:windowMinWidthMinor">0%</item>
    </style>
    <style name="Theme.Default.Alert.Fullscreen" parent="@android:style/Theme.Dialog">
        <item name="android:buttonStyle">@style/Widget.Button.Dialog</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:checkboxStyle">@style/Widget.CompoundButton.CheckBox</item>
        <item name="android:imageButtonStyle">@style/Widget.ImageButton</item>
        <item name="android:listViewStyle">@style/Widget.ListView</item>
        <item name="android:progressBarStyle">@style/Widget.ProgressBar</item>
        <item name="android:progressBarStyleHorizontal">@style/Widget.ProgressBar.Horizontal</item>
        <item name="android:radioButtonStyle">@style/Widget.CompoundButton.RadioButton</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
    </style>
    <style name="ActionBarStyle" parent="@android:style/Widget.Holo.ActionBar">
        <item name="android:background">@drawable/tw_ab_transparent_dark_holo</item>
        <item name="android:displayOptions">0x1</item>
    </style>
    <style name="ActionButtonStyle" parent="@android:style/Widget.Holo.ActionButton">
        <item name="android:background">@drawable/selector_actionbar_button</item>
    </style>
    <style name="Widget.PopupWindow" parent="@android:style/Widget.Holo.PopupWindow">
        <item name="android:popupBackground">@drawable/tw_menu_ab_dropdown_panel_holo_dark</item>
    </style>
    <style name="Widget.ListView" parent="@android:style/Widget.Holo.ListView">
        <item name="android:listSelector">@drawable/selector_list</item>
        <item name="android:cacheColorHint">@android:color/transparent</item>
        <item name="android:divider">@drawable/tw_list_divider_holo_dark</item>
    </style>
    <style name="Widget.ImageButton" parent="@android:style/Widget.Holo.ImageButton">
        <item name="android:background">@drawable/selector_default_button</item>
    </style>
    <style name="Widget.Button" parent="@android:style/Widget.Holo.Button">
        <item name="android:textColor">@color/selector_text</item>
        <item name="android:background">@drawable/selector_default_button</item>
    </style>
    <style name="Widget.Button.Dialog" parent="@android:style/Widget.Holo.Button">
        <item name="android:textColor">@color/selector_dialog_button_text</item>
        <item name="android:background">@drawable/selector_dialog_button</item>
    </style>
    <style name="Widget.CompoundButton.CheckBox" parent="@android:style/Widget.Holo.CompoundButton.CheckBox">
        <item name="android:button">@drawable/selector_checkbox</item>
    </style>
    <style name="Widget.CompoundButton.RadioButton" parent="@android:style/Widget.Holo.CompoundButton.RadioButton">
        <item name="android:button">@drawable/selector_radio_button</item>
    </style>
    <style name="Widget.ProgressBar" parent="@android:style/Widget.Holo.ProgressBar">
        <item name="android:indeterminateDrawable">@anim/loading</item>
    </style>
    <style name="Widget.ProgressBar.Horizontal" parent="@android:style/Widget.Holo.ProgressBar.Horizontal">
        <item name="android:maxHeight">6dp</item>
        <item name="android:progressDrawable">@drawable/progressbar_horizontal</item>
        <item name="android:minHeight">6dp</item>
    </style>
</resources>
